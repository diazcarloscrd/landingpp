# CDByte - Variables de Entorno de Ejemplo
# NO incluyas secretos reales en este archivo.

# Configuración de Base de Datos (Supabase)
# En servidor (Route Handlers) se requiere SUPABASE_URL y la clave privada SUPABASE_SERVICE_ROLE_KEY.
# NUNCA expongas SUPABASE_SERVICE_ROLE_KEY al bundle cliente (NO uses el prefijo NEXT_PUBLIC_).
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada

# Clave pública anon (opcional, para uso exclusivo en cliente si se requiriera en el futuro)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Notificaciones Administrativas (Opcional - Telegram Bot)
# Para recibir una alerta instantánea en tu móvil cuando ingrese una cotización.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Rate Limiting Persistente Distribuido (Opcional - Upstash Redis en Vercel)
# Si no se configuran, el sistema utiliza el limitador en memoria local.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# URL Base del Sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000
